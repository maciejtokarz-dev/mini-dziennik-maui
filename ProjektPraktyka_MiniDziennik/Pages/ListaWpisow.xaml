<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjektPraktyka_MiniDziennik.Pages.ListaWpisow"
             BackgroundColor="#F9F6F0"
             Title="Lista Wpisów"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Padding="20,16" VerticalOptions="Center">
            <Button Text="‹" 
                    FontSize="28" 
                    TextColor="#1E1E1E" 
                    BackgroundColor="Transparent" 
                    Padding="0" 
                    HeightRequest="40" 
                    WidthRequest="40" 
                    HorizontalOptions="Start" />

            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                <Label Text="WAGA" 
                       FontSize="11" 
                       TextColor="#EF795A" 
                       FontAttributes="Bold" 
                       CharacterSpacing="1" />
                <Label Text="Historia wpisów" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="#1E1E1E" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1" Padding="20,0,20,90" IsVisible="True">
            <VerticalStackLayout Spacing="20">

                <VerticalStackLayout Spacing="8">
                    <Label Text="DZISIAJ" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="#EF795A" 
                           CharacterSpacing="1" />

                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.02" Offset="0,2" Radius="8"/>
                        </Border.Shadow>

                        <Grid ColumnDefinitions="*, Auto" Padding="8,4">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="78,5 kg" FontSize="20" FontAttributes="Bold" TextColor="#1E1E1E" />
                                <Label Text="07:10" FontSize="12" TextColor="#9B9893" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#9B9893" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="WCZORAJ" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="#EF795A" 
                           CharacterSpacing="1" />

                    <Border BackgroundColor="#FFFFFF" StrokeShape="RoundRectangle 20" StrokeThickness="0" Padding="12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.02" Offset="0,2" Radius="8"/>
                        </Border.Shadow>

                        <VerticalStackLayout Spacing="0">

                            <Grid ColumnDefinitions="*, Auto" Padding="8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="78,9 kg" FontSize="20" FontAttributes="Bold" TextColor="#1E1E1E" />
                                    <Label Text="19:30" FontSize="12" TextColor="#9B9893" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#9B9893" VerticalOptions="Center" />
                            </Grid>

                            <BoxView HeightRequest="1" Color="#EFECE5" Margin="8,4" />

                            <Grid ColumnDefinitions="*, Auto" Padding="8,8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="79,1 kg" FontSize="20" FontAttributes="Bold" TextColor="#1E1E1E" />
                                    <Label Text="08:15" FontSize="12" TextColor="#9B9893" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="›" FontSize="20" TextColor="#9B9893" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" 
                               VerticalOptions="Center" 
                               HorizontalOptions="Center" 
                               Spacing="16" 
                               Padding="40" 
                               IsVisible="False">
            <Border BackgroundColor="#EFECE5" 
                    StrokeShape="RoundRectangle 40" 
                    WidthRequest="80" 
                    HeightRequest="80" 
                    StrokeThickness="0" 
                    HorizontalOptions="Center">
                <Label Text="⚖️" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Brak wpisów" 
                   FontSize="20" 
                   FontAttributes="Bold" 
                   TextColor="#1E1E1E" 
                   HorizontalOptions="Center" />

            <Label Text="Nie dodano jeszcze żadnego pomiaru dla tego typu." 
                   FontSize="14" 
                   TextColor="#9B9893" 
                   HorizontalTextAlignment="Center" />

            <Button Text="Dodaj pierwszy wpis" 
                    BackgroundColor="#EF795A" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="16" 
                    Padding="24,12" 
                    Margin="0,8,0,0" />
        </VerticalStackLayout>

        <Button Grid.Row="1"
                Text="+" 
                FontSize="28"
                TextColor="White"
                FontAttributes="Bold"
                BackgroundColor="#EF795A"
                CornerRadius="28"
                WidthRequest="56"
                HeightRequest="56"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,24,24">
            <Button.Shadow>
                <Shadow Brush="#EF795A" Opacity="0.35" Offset="0,4" Radius="8"/>
            </Button.Shadow>
        </Button>

    </Grid>

</ContentPage>