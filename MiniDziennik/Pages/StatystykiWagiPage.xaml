<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    x:Class="MiniDziennik.Pages.StatystykiWagiPage"
    BackgroundColor="{StaticResource KolorTla}"
    Title="StatystykiWagiPage"
    Shell.NavBarIsVisible="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="24,20,24,30"
            Spacing="20">

            <!-- GÓRNY PASEK -->
            <Grid
                ColumnDefinitions="50,*,50"
                HeightRequest="50">

                <!-- Powrót - zmieniono z Label na Button, aby obsłużyć WsteczCommand -->
                <Button
                    Grid.Column="0"
                    Text="&lt;"
                    Command="{Binding WsteczCommand}"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource KolorTekstu}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

                <!-- Tytuł -->
                <Label
                    Grid.Column="1"
                    Text="Statystyki"
                    FontSize="21"
                    FontAttributes="Bold"
                    TextColor="{StaticResource KolorTekstu}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />

            </Grid>

            <!-- NAGŁÓWEK -->
            <VerticalStackLayout
                Margin="4,10,4,0"
                Spacing="4">

                <Label
                    Text="Waga"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="{StaticResource KolorTekstu}" />

                <Label
                    Text="Zobacz swoje pomiary w czasie"
                    FontSize="15"
                    TextColor="{StaticResource KolorTekstuDrugorzednego}" />

            </VerticalStackLayout>

            <!-- PRZEŁĄCZNIK ZAKRESU -->
            <Border
                BackgroundColor="{StaticResource KolorPola}"
                Stroke="Transparent"
                Padding="5"
                StrokeShape="RoundRectangle 16">

                <Grid
                    ColumnDefinitions="*,*"
                    HeightRequest="48">

                    <!-- 7 DNI -->
                    <Button
                        Grid.Column="0"
                        Text="7 dni"
                        FontSize="15"
                        FontAttributes="Bold"
                        Command="{Binding UstawZakresCommand}"
                        CommandParameter="7"
                        CornerRadius="12">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Is7Dni}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource KolorAkcentu}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Is7Dni}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{StaticResource KolorTekstu}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <!-- 30 DNI -->
                    <Button
                        Grid.Column="1"
                        Text="30 dni"
                        FontSize="15"
                        FontAttributes="Bold"
                        Command="{Binding UstawZakresCommand}"
                        CommandParameter="30"
                        CornerRadius="12">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Is30Dni}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource KolorAkcentu}" />
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Is30Dni}" Value="False">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="TextColor" Value="{StaticResource KolorTekstu}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                </Grid>

            </Border>

            <!-- KARTA WYKRESU -->
            <Border
                BackgroundColor="{StaticResource KolorKarty}"
                Stroke="Transparent"
                Padding="15"
                StrokeShape="RoundRectangle 24">

                <Border.Shadow>
                    <Shadow
                        Brush="#20000000"
                        Offset="0,4"
                        Radius="12"
                        Opacity="0.10" />
                </Border.Shadow>

                <!-- MIEJSCE NA WYKRES -->
                <lvc:CartesianChart
                    Series="{Binding SerieWykresu}"
                    XAxes="{Binding OsX}"
                    YAxes="{Binding OsY}"
                    HeightRequest="270"
                    ZoomMode="None" />

            </Border>

            <!-- STATYSTYKI -->
            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="10">

                <!-- MINIMUM -->
                <Border
                    Grid.Column="0"
                    BackgroundColor="{StaticResource KolorKarty}"
                    Stroke="Transparent"
                    Padding="13"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="MIN"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource KolorTekstuDrugorzednego}" />

                        <Label
                            Text="{Binding MinWaga}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource KolorTekstu}" />
                    </VerticalStackLayout>

                </Border>

                <!-- ŚREDNIA -->
                <Border
                    Grid.Column="1"
                    BackgroundColor="{StaticResource KolorKarty}"
                    Stroke="Transparent"
                    Padding="13"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="ŚREDNIA"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource KolorTekstuDrugorzednego}" />

                        <Label
                            Text="{Binding SredniaWaga}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource KolorTekstu}" />
                    </VerticalStackLayout>

                </Border>

                <!-- MAKSIMUM -->
                <Border
                    Grid.Column="2"
                    BackgroundColor="{StaticResource KolorKarty}"
                    Stroke="Transparent"
                    Padding="13"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="5">
                        <Label
                            Text="MAX"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource KolorTekstuDrugorzednego}" />

                        <Label
                            Text="{Binding MaxWaga}"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource KolorTekstu}" />
                    </VerticalStackLayout>

                </Border>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>